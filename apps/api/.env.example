NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string — put the REAL value only in your local .env, never commit it.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<dbname>

# JWT secrets — generate strong random values, e.g. `openssl rand -hex 32`
ACCESS_TOKEN_SECRET=replace-with-strong-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_SECRET=replace-with-strong-random-secret
REFRESH_TOKEN_TTL=7d

COOKIE_DOMAIN=localhost

# CORS — the two frontend origins allowed to call this API with credentials
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001

# Cloudinary — placeholders, unused until the Media Library phase
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seed script — required, no default is provided on purpose
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
